[
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "List one level of ICD-10 PL, ICD-9 PL or ICD-11 PL: the chapters when parent and node are omitted, else the children of parent or of a node id from an earlier listing (ICD-11 blocks have a node id, no code). Levels stop at 400 entries with truncated=true. Use search_codes for words, get_code for one code's details.",
    "inputSchema": {
      "$defs": {
        "Code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.\\-]{0,15}$",
          "type": "string"
        },
        "System": {
          "enum": [
            "icd10-pl",
            "icd9-pl",
            "icd11-pl"
          ],
          "type": "string"
        }
      },
      "properties": {
        "node": {
          "anyOf": [
            {
              "maximum": 10000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Node id from an earlier listing, for ICD-11 blocks without a code."
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Code"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Code whose children to list."
        },
        "system": {
          "$ref": "#/$defs/System",
          "description": "Classification of the code."
        }
      },
      "required": [
        "system"
      ],
      "type": "object"
    },
    "name": "browse_codes",
    "outputSchema": {
      "$defs": {
        "Json": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "additionalProperties": true,
      "properties": {
        "children": {
          "items": {
            "$ref": "#/$defs/Json"
          },
          "type": "array"
        },
        "notice": {
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Json"
            },
            {
              "type": "null"
            }
          ]
        },
        "release_id": {
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "notice",
        "system",
        "release_id",
        "parent",
        "children",
        "truncated"
      ],
      "type": "object"
    },
    "title": "Browse a classification"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Browse the JGP catalog in force on service_date: without catalog and section, the sections of catalogs 1a and 1ae with group counts; with both, that section's groups and base points. Find a group by words with search_codes; open one with get_jgp_group.",
    "inputSchema": {
      "$defs": {
        "Catalog": {
          "enum": [
            "1a",
            "1ae"
          ],
          "type": "string"
        }
      },
      "properties": {
        "catalog": {
          "anyOf": [
            {
              "$ref": "#/$defs/Catalog"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Catalog of the section; omit with section for the index."
        },
        "section": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Section number from the index."
        },
        "service_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Day of care, YYYY-MM-DD; picks the release in force. Default today in Poland."
        }
      },
      "type": "object"
    },
    "name": "browse_jgp_catalog",
    "outputSchema": {
      "additionalProperties": true,
      "description": "A JGP or grouping answer of the HTTP API, with the notice.",
      "properties": {
        "notice": {
          "type": "string"
        }
      },
      "required": [
        "notice"
      ],
      "type": "object"
    },
    "title": "Browse the JGP catalog"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Compare one JGP group between the catalogs in force on two service dates: act, release, name, base points, scopes and condition list names on each side, plus the fields that changed. Use get_jgp_group for the full conditions on one date.",
    "inputSchema": {
      "$defs": {
        "GroupCode": {
          "pattern": "^[A-Z][A-Z0-9]{1,5}$",
          "type": "string"
        }
      },
      "properties": {
        "after_date": {
          "description": "Later day of care, YYYY-MM-DD.",
          "format": "date",
          "type": "string"
        },
        "before_date": {
          "description": "Earlier day of care, YYYY-MM-DD.",
          "format": "date",
          "type": "string"
        },
        "code": {
          "$ref": "#/$defs/GroupCode",
          "description": "JGP group code, e.g. F72."
        }
      },
      "required": [
        "code",
        "before_date",
        "after_date"
      ],
      "type": "object"
    },
    "name": "compare_jgp_group",
    "outputSchema": {
      "$defs": {
        "Json": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "additionalProperties": true,
      "properties": {
        "after": {
          "$ref": "#/$defs/Json"
        },
        "before": {
          "$ref": "#/$defs/Json"
        },
        "changed": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "code": {
          "type": "string"
        },
        "notice": {
          "type": "string"
        }
      },
      "required": [
        "notice",
        "code",
        "before",
        "after",
        "changed"
      ],
      "type": "object"
    },
    "title": "Compare a JGP group between dates"
  },
  {
