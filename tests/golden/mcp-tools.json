                  "default": null
                }
              },
              "required": [
                "code"
              ],
              "type": "object"
            },
            "procedures": {
              "default": [],
              "items": {
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "maxLength": 16,
                    "minLength": 1,
                    "type": "string"
                  },
                  "performed_on": {
                    "anyOf": [
                      {
                        "format": "date",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "stay_id": {
                    "anyOf": [
                      {
                        "maxLength": 32,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  }
                },
                "required": [
                  "code"
                ],
                "type": "object"
              },
              "maxItems": 1000,
              "type": "array"
            },
            "product_reporting": {
              "enum": [
                "unknown",
                "complete"
              ],
              "type": "string"
            },
            "secondary_diagnoses": {
              "default": [],
              "items": {
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "maxLength": 16,
                    "minLength": 1,
                    "type": "string"
                  },
                  "hospitalization_level": {
                    "default": false,
                    "type": "boolean"
                  },
                  "stay_id": {
                    "anyOf": [
                      {
                        "maxLength": 32,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  }
                },
                "required": [
                  "code"
                ],
                "type": "object"
              },
              "maxItems": 100,
              "type": "array"
            },
            "settlement_products": {
