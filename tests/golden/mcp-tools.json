                  },
                  "ended_on": {
                    "anyOf": [
                      {
                        "format": "date",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "started_on": {
                    "anyOf": [
                      {
                        "format": "date",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  }
                },
                "required": [
                  "code"
                ],
                "type": "object"
              },
              "maxItems": 1000,
              "type": "array"
            },
            "stays": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "admitted_on": {
                    "format": "date",
                    "type": "string"
                  },
                  "department": {
                    "maxLength": 4,
                    "minLength": 4,
                    "type": "string"
                  },
                  "discharged_on": {
                    "format": "date",
                    "type": "string"
                  },
                  "identifier": {
                    "maxLength": 32,
                    "minLength": 1,
                    "type": "string"
                  },
                  "service_code": {
                    "anyOf": [
                      {
                        "maxLength": 16,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
