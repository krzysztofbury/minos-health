// Minos tailnet policy (#227): the complete file for the Tailscale admin
// console's JSON editor, reviewed here like any other host boundary.
{
	// Only tailnet admins may tag a device as the Minos server; the host joins
	// with a one-time auth key carrying this tag.
	"tagOwners": {
		"tag:minos-server": ["autogroup:admin"],
	},

	"grants": [
		// The owner's own devices keep reaching each other, as under the
		// default allow-all rule this replaces.
		{"src": ["autogroup:member"], "dst": ["autogroup:self"], "ip": ["*"]},

		// Admin devices reach the Minos server on SSH only. No grant names the
		// server as a source, so it can start no connection on the tailnet.
		{"src": ["autogroup:admin"], "dst": ["tag:minos-server"], "ip": ["tcp:22"]},
	],

	// No "ssh" section, so Tailscale SSH is denied on every device. The server
	// runs OpenSSH with a pinned host key and joins with --ssh=false, and no
	// device needs the Tailscale SSH server; a rule would only add a path a
	// compromised node could follow.
}
