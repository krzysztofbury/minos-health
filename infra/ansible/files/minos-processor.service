[Unit]
Description=Minos data-update processor and data-only activation (#141)
Requires=docker.service
After=docker.service minos-compose.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /opt/minos/bin/processor_host.py
# The runner kills a container after 75 minutes; two activation attempts
# with their checks add up to about 25 minutes.
TimeoutStartSec=110min
Nice=10
