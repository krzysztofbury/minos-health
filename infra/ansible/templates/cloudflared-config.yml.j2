tunnel: {{ cloudflared_tunnel_id }}
credentials-file: /run/secrets/cloudflared-credentials.json
metrics: 127.0.0.1:2000
loglevel: info

ingress:
  - hostname: minoshealth.pl
    service: http://edge:8080
  - hostname: minoshealth.com
    service: http://edge:8080
  - hostname: www.minoshealth.com
    service: http://edge:8080
{% if uptime_kuma_public_status_enabled | bool %}
  - hostname: status.minoshealth.pl
    service: http://uptime-kuma:3001
{% endif %}
  - service: http_status:404
