# Current status: the RSK transport reads the active settings below from .env,
# but there is no executable watcher, Dockerfile, or Compose service yet.
# Copy this file to .env only for direct Python development and tests.

# Active: RSK anonymous API transport
MINOS_RSK_ROLE_CATALOG_URL=https://rsk3.ezdrowie.gov.pl/api/rsk/resource/role/UZYNLG
MINOS_RSK_BASIC_INFO_BASE_URL=https://rsk3.ezdrowie.gov.pl/api/rsk/resource/basic-info/
MINOS_RSK_FILE_DOWNLOAD_BASE_URL=https://rsk3.ezdrowie.gov.pl/api/rsk/file/get/
MINOS_RSK_TIMEOUT_SECONDS=20
MINOS_RSK_CONNECT_TIMEOUT_SECONDS=5
MINOS_RSK_METADATA_MAX_BYTES=5242880
MINOS_RSK_FILE_MAX_BYTES=536870912
MINOS_RSK_RETRY_MAX_ATTEMPTS=3
MINOS_RSK_RETRY_BASE_SECONDS=0.5
MINOS_RSK_RETRY_MAX_SECONDS=30
MINOS_RSK_OPERATION_DEADLINE_SECONDS=300
MINOS_RSK_USER_AGENT=minos-health/0.0.1 rsk-watcher

# Reserved for the future watcher entry point and structured process logging.
# These variables are not read by the current application.
# MINOS_ENV=local
# MINOS_LOG_LEVEL=INFO
# MINOS_LOG_FORMAT=console

# Reserved until the control database, archive contract, and Compose service
# are implemented.
# MINOS_ARCHIVE_BACKEND=filesystem
# MINOS_ARCHIVE_PATH=/var/lib/minos/blobs
# MINOS_CONTROL_DATABASE_PATH=/var/lib/minos/control.sqlite3

# Reserved for the future S3 archive adapter. These are configuration, not
# credentials. Local development uses an external profile; production mounts a
# service-restricted credential file for the pinned watcher UID/GID. Do not put
# access keys in this file.
# AWS_REGION=eu-central-1
# MINOS_S3_BUCKET=<snapshot-bucket-name>
# MINOS_S3_BLOB_PREFIX=blobs/sha256/
# MINOS_S3_RECOVERY_PREFIX=control-recovery/
