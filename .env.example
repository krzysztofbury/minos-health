# Current status: the source-neutral watcher runtime, local Compose stack, and
# recovery operator commands are executable. Source-specific collection remains
# disabled until issue #6 registers the RSK collector.
# Copy this file to .env only for direct Python development and tests.

# Active: RSK anonymous API transport
MINOS_RSK_ROLE_CATALOG_URL=https://rsk3.ezdrowie.gov.pl/api/rsk/resource/role/UZYNLG
MINOS_RSK_BASIC_INFO_BASE_URL=https://rsk3.ezdrowie.gov.pl/api/rsk/resource/basic-info/
MINOS_RSK_FILE_DOWNLOAD_BASE_URL=https://rsk3.ezdrowie.gov.pl/api/rsk/file/get/
MINOS_RSK_TIMEOUT_SECONDS=20
MINOS_RSK_CONNECT_TIMEOUT_SECONDS=5
MINOS_RSK_METADATA_MAX_BYTES=5242880
MINOS_RSK_FILE_MAX_BYTES=536870912
MINOS_RSK_RETRY_MAX_ATTEMPTS=3
MINOS_RSK_RETRY_BASE_SECONDS=0.5
MINOS_RSK_RETRY_MAX_SECONDS=30
MINOS_RSK_OPERATION_DEADLINE_SECONDS=300
MINOS_RSK_USER_AGENT=minos-health/0.0.1 rsk-watcher

# Reserved for structured process logging.
# MINOS_ENV=local
# MINOS_LOG_LEVEL=INFO
# MINOS_LOG_FORMAT=console

# Active watcher runtime settings for direct local execution.
MINOS_WATCHER_ARCHIVE_BACKEND=filesystem
MINOS_WATCHER_DATABASE=.minos/control/control.sqlite3
MINOS_WATCHER_STAGING_DIRECTORY=.minos/staging
MINOS_WATCHER_ARCHIVE_DIRECTORY=.minos/archive
# The only accepted process lock is .minos/control/watcher.lock, derived from
# MINOS_WATCHER_DATABASE. An explicit value must match it exactly.
# MINOS_WATCHER_PROCESS_LOCK=.minos/control/watcher.lock
# MINOS_WATCHER_RECOVERY_STAGING_DIRECTORY=.minos/control/recovery-staging
# MINOS_WATCHER_CONTROL_MAX_BYTES=2147483648
# MINOS_WATCHER_DOWNLOAD_MAX_BYTES=536870912
# MINOS_WATCHER_STAGING_QUOTA_BYTES=629145600
# MINOS_WATCHER_MIN_FREE_BYTES=1073741824

# Production S3 and heartbeat configuration. These are identifiers and file
# paths, not credentials. Production mounts service-restricted files for the
# pinned watcher UID/GID. Do not put access keys or ping URLs in this file.
# AWS_REGION=eu-central-1
# AWS_SHARED_CREDENTIALS_FILE=/run/secrets/aws-credentials
# MINOS_WATCHER_ARCHIVE_BACKEND=s3
# MINOS_WATCHER_S3_BUCKET=<snapshot-bucket-name>
# MINOS_WATCHER_S3_EXPECTED_BUCKET_OWNER=<twelve-digit-account-id>
# MINOS_WATCHER_HEALTHCHECKS_TARGETS_FILE=/run/secrets/healthchecks-targets.json
# MINOS_WATCHER_SCHEDULER_PAUSED=true
# MINOS_WATCHER_IMAGE_DIGEST=sha256:<reviewed-image-digest>
# MINOS_WATCHER_RUNTIME_IMAGE_DIGEST=sha256:<independently-observed-digest>
