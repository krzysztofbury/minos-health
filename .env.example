# Runtime mode and privacy-safe logging
MINOS_ENV=local
MINOS_LOG_LEVEL=INFO
MINOS_LOG_FORMAT=console

# RSK anonymous API
MINOS_RSK_ROLE_CATALOG_URL=https://rsk3.ezdrowie.gov.pl/api/rsk/resource/role/UZYNLG
MINOS_RSK_BASIC_INFO_BASE_URL=https://rsk3.ezdrowie.gov.pl/api/rsk/resource/basic-info/
MINOS_RSK_FILE_DOWNLOAD_BASE_URL=https://rsk3.ezdrowie.gov.pl/api/rsk/file/get/
MINOS_RSK_TIMEOUT_SECONDS=20
MINOS_RSK_CONNECT_TIMEOUT_SECONDS=5
MINOS_RSK_USER_AGENT=minos-health-rsk-watcher

# Local archive profile. The directory is mounted persistently by Compose.
MINOS_ARCHIVE_BACKEND=filesystem
MINOS_ARCHIVE_PATH=/var/lib/minos/archive

# AWS integration profile. These values are configuration, not credentials.
AWS_REGION=<aws-region>
MINOS_S3_BUCKET=<snapshot-bucket-name>
MINOS_S3_ARCHIVE_PREFIX=archive/
MINOS_S3_STATE_PREFIX=state/
